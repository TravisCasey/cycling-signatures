"""Type stubs for the compiled cycling-signatures extension module."""

import os

import numpy as np
from numpy.typing import NDArray

from cycling_signatures import Interpolator, Metric, Segment

class FormatVersionMismatchError(Exception):
    """Raised when a loaded file's format version does not match this build."""

class Euclidean:
    """The ordinary Euclidean distance metric."""

    def __init__(self) -> None: ...
    def distance(self, point: NDArray[np.float64], other: NDArray[np.float64]) -> float: ...
    def distance_matrix(self, points: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def __repr__(self) -> str: ...

class SphereBundle:
    """A metric on position/direction pairs: max Euclidean distance per half."""

    def __init__(self) -> None: ...
    def distance(self, point: NDArray[np.float64], other: NDArray[np.float64]) -> float: ...
    def distance_matrix(self, points: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def __repr__(self) -> str: ...

class CubicSpline:
    """A piecewise cubic interpolator through a sequence of knots and values."""

    def __init__(self, knots: NDArray[np.float64], values: NDArray[np.float64]) -> None: ...
    def sample(self, parameter: float) -> NDArray[np.float64]: ...
    def knots(self) -> NDArray[np.float64]: ...

class SphereBundleInterpolator:
    """A cubic spline paired with a spherical direction component."""

    def __init__(self, inner: CubicSpline, direction_radius: float) -> None: ...
    def direction_radius(self) -> float: ...
    def sample(self, parameter: float) -> NDArray[np.float64]: ...

class HomologyClass:
    """An F_2 cohomology class, expressed against the cover generator basis."""

    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __xor__(self, other: HomologyClass) -> HomologyClass: ...
    def __repr__(self) -> str: ...
    def is_zero(self) -> bool: ...
    def nonzero_indices(self) -> list[int]: ...
    def to_array(self) -> NDArray[np.uint8]: ...

class Subspace:
    """A span: classes closed under addition, held as an RREF basis."""

    def rank(self) -> int: ...
    def num_generators(self) -> int: ...
    def basis(self) -> list[HomologyClass]: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...
    def contains(self, homology_class: HomologyClass) -> bool: ...

class CyclingSignature:
    """The rank and span of a segment's classes, as a function of threshold."""

    def span(self) -> Subspace: ...
    def rank(self) -> int: ...
    def rank_at(self, threshold: float) -> int:
        """Rank of the span using only classes born at or below `threshold`."""

    def span_at(self, threshold: float) -> Subspace:
        """The span of classes born at or below `threshold`."""

    def births(self) -> list[float]: ...
    def classes(self) -> list[HomologyClass]: ...
    def threshold_max(self) -> float:
        """The adjacency threshold this signature was computed at."""

    def num_generators(self) -> int: ...
    def __repr__(self) -> str: ...

class Trajectory:
    """A sampled curve with one index space and a carried parameterization."""

    def __init__(
        self, points: NDArray[np.float64], parameters: NDArray[np.float64] | None = None
    ) -> None: ...
    @staticmethod
    def resample(
        interpolator: Interpolator,
        metric: Metric,
        spacing: float,
    ) -> Trajectory: ...
    def downsample(self, metric: Metric, spacing: float) -> Trajectory: ...
    def resolution(self, metric: Metric) -> float:
        """The maximum distance between consecutive points."""

    def points(self) -> NDArray[np.float64]: ...
    def parameters(self) -> NDArray[np.float64]: ...
    def __len__(self) -> int: ...
    def dimension(self) -> int: ...
    def fingerprint(self) -> int:
        """Content hash for this trajectory, stable across save and load."""

    def save(self, path: str | os.PathLike[str]) -> None: ...
    @staticmethod
    def load(path: str | os.PathLike[str]) -> Trajectory: ...

class CubicalCover:
    """A cubical complex covering a trajectory, carrying its generator basis."""

    def __init__(self, trajectory: Trajectory, *, parallel: bool = True) -> None: ...
    def fingerprint(self) -> int:
        """Content hash for this cover, stable across save and load."""

    def __len__(self) -> int: ...
    def cubes(self) -> NDArray[np.int64]: ...
    def dimension(self) -> int: ...
    def num_generators(self) -> int: ...
    def save(self, path: str | os.PathLike[str]) -> None: ...
    @staticmethod
    def load(path: str | os.PathLike[str]) -> CubicalCover: ...

class EmbeddedTrajectory:
    """A trajectory paired with the cubical cover its points are mapped into."""

    def __init__(self, trajectory: Trajectory, cover: CubicalCover, metric: Metric) -> None: ...
    @staticmethod
    def from_interpolator(
        interpolator: Interpolator,
        metric: Metric,
        resample_spacing: float,
        downsample_spacing: float,
        *,
        parallel: bool = True,
    ) -> EmbeddedTrajectory: ...
    def signature(
        self, segment: Segment, threshold: float, *, parallel: bool = True
    ) -> CyclingSignature: ...
    def cycle_class(self, segment: Segment) -> HomologyClass: ...
    def resolution(self) -> float:
        """The maximum distance between consecutive detection points."""

    def trajectory(self) -> Trajectory: ...
    def cover(self) -> CubicalCover: ...
    def metric(self) -> Metric: ...
    def __len__(self) -> int: ...
    def fingerprint(self) -> int:
        """Content hash for this embedding, stable across save and load."""

    def save(
        self,
        embedded_path: str | os.PathLike[str],
        trajectory_path: str | os.PathLike[str],
        cover_path: str | os.PathLike[str],
    ) -> None: ...
    @staticmethod
    def load(
        embedded_path: str | os.PathLike[str],
        trajectory_path: str | os.PathLike[str],
        cover_path: str | os.PathLike[str],
    ) -> EmbeddedTrajectory: ...

class Cycle:
    """A single detected occurrence of a recurrent motion."""

    def range(self) -> tuple[int, int]: ...
    def birth(self) -> float: ...
    def length(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...

class Component:
    """The cycles sharing one class, with the index range they cover."""

    def class_id(self) -> int:
        """The index of this component's class in the storage's class list."""

    def coverage(self) -> tuple[int, int]:
        """The index range this component's cycles cover."""

    def cycles(self) -> list[Cycle]: ...
    def cycle_count(self) -> int: ...
    def longest_cycle(self) -> Cycle: ...
    def shortest_cycle(self) -> Cycle: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Cycle: ...
    def __repr__(self) -> str: ...

class CycleStorage:
    """The detected components for a segment, indexed by class and point."""

    @staticmethod
    def build(
        embedded: EmbeddedTrajectory,
        segment: Segment,
        max_length: int,
        threshold: float,
        *,
        parallel: bool = True,
    ) -> CycleStorage: ...
    def extent(self) -> tuple[int, int]:
        """The index range this storage was built from."""

    def fingerprint(self) -> int:
        """The fingerprint of the embedded trajectory this was built from."""

    def threshold(self) -> float: ...
    def max_length(self) -> int: ...
    def num_generators(self) -> int: ...
    def classes(self) -> list[HomologyClass]: ...
    def components(self) -> list[Component]: ...
    def component(self, component_id: int) -> Component: ...
    def homology_class(self, component_id: int) -> HomologyClass: ...
    def signature(self, segment: Segment) -> CyclingSignature: ...
    def components_covering(self, point: int) -> list[int]:
        """The ids of the components whose cycles cover the given index."""

    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Component: ...
    def __repr__(self) -> str: ...
    def save(self, path: str | os.PathLike[str]) -> None: ...
    @staticmethod
    def load(path: str | os.PathLike[str]) -> CycleStorage: ...

__all__ = [
    "Component",
    "CubicSpline",
    "CubicalCover",
    "Cycle",
    "CycleStorage",
    "CyclingSignature",
    "EmbeddedTrajectory",
    "Euclidean",
    "FormatVersionMismatchError",
    "HomologyClass",
    "SphereBundle",
    "SphereBundleInterpolator",
    "Subspace",
    "Trajectory",
]
